# Copy this file to .env and fill in your values
NODE_ENV=production
PORT=3000

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# AWS region — credentials come from the EC2 IAM role automatically on the server.
AWS_REGION=us-east-2

# Discord OAuth — https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://universal-realms.com/api/auth/discord/callback

# ── World Engine (worlds.html / world.html / Atlas Studio) — see docs/WORLD_ENGINE.md ──
# Lore assistant. Without a key, everything else still works and the chat says it is not set up.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LORE_MAX_PER_HOUR=60

# Storage: dynamo + s3 in production; file + local for a laptop.
WORLD_DB=dynamo
WORLDS_TABLE=ur_worlds
WORLD_STORE=s3
WORLD_BUCKET=universal-realms-worlds
# Where world data lives when WORLD_DB=file or WORLD_STORE=local (jobs use the system temp dir):
DATA_DIR=./data

# Python engine jobs (map generation, Atlas Studio edits, history)
# PYTHON_BIN defaults to engine/.venv/bin/python (made by: npm run engine:setup)
JOB_CONCURRENCY=1
JOB_TIMEOUT_MS=600000
MAX_WORLDS_PER_USER=25
