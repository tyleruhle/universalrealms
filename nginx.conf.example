# Nginx config for Universal Realms
# Place at: /etc/nginx/sites-available/universal-realms
# Enable:   sudo ln -s /etc/nginx/sites-available/universal-realms /etc/nginx/sites-enabled/
# Reload:   sudo systemctl reload nginx

server {
    listen 80;
    server_name universal-realms.com www.universal-realms.com;

    # Cloudflare handles SSL termination — Nginx only sees HTTP from Cloudflare's edge
    # If you add an origin certificate later, switch to port 443 with ssl_certificate

    # Proxy all traffic to Node.js
    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
